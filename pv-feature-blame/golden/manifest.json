{
  "playbook": "pv-feature-blame",
  "note": "金标准输入由 make_golden.py 确定性生成（零随机）；期望值来自 scripts/ 本体在金标准上的实跑并留容差。埋点：f_blame（day2 崩坏且耦合进 M1/ensemble → 必须被点名）、f_decoy（day5 崩坏、误差更大但零耦合 → 必须不被点名）、f_good/ghi（零误差；ghi 用奇异命名对 nwp_ghi_fc/ghi_obs 练配对启发式）、mystery_x（必须进 unmapped）。v2 翻新埋点：f_jumpy（parity 跳变 s(T)·A(t)，pred_M3 消费它 → revision 两关必点名；注意其真值误差路径 Spearman 仅 0.28（相位差）恰低于 0.3 点名线——真值误差抓不到、翻新分析才抓得到，这正是新轴的存在理由）、f_jumpy_decoy（period-4 方波跳变、幅更大、零耦合 → 必须不被点名：跳变大≠有罪）。Stage 1/2 的中间产物（feature_pairs/bad_rows_*）由 Stage 0/1 实跑生成后拷入，改上游脚本后需重生成。counterfactual_api 的 HTTP 层无法金标准化（需活 FastAPI，gen_gate 也禁网络导入），但其决策逻辑在 cf_logic.py（零网络）经 stage \"4\" 的 --selfcheck 过闸；--dry-run payload 确认步兜底。改本文件期望前先改 make_golden.py 并重跑 pytest。",
  "planted": {
    "blamed_feature": "f_blame",
    "decoy_feature": "f_decoy",
    "jumpy_feature": "f_jumpy",
    "jumpy_decoy_feature": "f_jumpy_decoy",
    "jumpy_model": "pred_M3",
    "ultra_short_bad_row": "2025-01-02 09:00:00",
    "short_bad_row": "2025-01-01 09:00:00"
  },
  "stages": {
    "0": {
      "desc": "schema 探查：2 模型列、4 特征对（含奇异命名）、mystery_x 进 unmapped、对齐与交叉核验全过",
      "inputs": ["golden_test.parquet", "golden_predict.parquet", "golden_feature_true.parquet"],
      "args": ["--test", "golden_test.parquet", "--predict", "golden_predict.parquet",
               "--feature-true", "golden_feature_true.parquet"],
      "expect": [
        {"file": "probe_schema.json", "path": "n_models", "op": "eq", "value": 3},
        {"file": "probe_schema.json", "path": "feature_names", "op": "contains", "value": "f_jumpy"},
        {"file": "probe_schema.json", "path": "timestamp_cols.feature_true", "op": "eq", "value": "timestamp_win"},
        {"file": "probe_schema.json", "path": "feature_names", "op": "contains", "value": "f_blame"},
        {"file": "probe_schema.json", "path": "feature_names", "op": "contains", "value": "ghi"},
        {"file": "probe_schema.json", "path": "unmapped", "op": "contains", "value": "mystery_x"},
        {"file": "probe_schema.json", "path": "alignment.n_common", "op": "eq", "value": 40},
        {"file": "probe_schema.json", "path": "alignment.align_offset_steps", "op": "eq", "value": 0},
        {"file": "probe_schema.json", "path": "window_consistency_bad_rate", "op": "le", "value": 0.0},
        {"file": "probe_schema.json", "path": "label_crosscheck.agree_rate", "op": "ge", "value": 0.99},
        {"file": "feature_pairs.json", "op": "exists"}
      ]
    },
    "1": {
      "desc": "坏行定位：M1/ensemble 两口径各恰 1 个坏行落在埋点时间戳；M3 的坏行来自 f_jumpy 跳变（ultra_short 4 个、short 0 个——跳变结构逐日相同，short 口径全行等误差）",
      "inputs": ["golden_test.parquet", "golden_predict.parquet"],
      "args": ["--test", "golden_test.parquet", "--predict", "golden_predict.parquet"],
      "expect": [
        {"file": "bad_rows_summary.json", "path": "metrics.ultra_short.pred_M1.n_rows", "op": "eq", "value": 40},
        {"file": "bad_rows_summary.json", "path": "metrics.ultra_short.pred_M1.n_bad", "op": "eq", "value": 1},
        {"file": "bad_rows_summary.json", "path": "metrics.ultra_short.pred_M1.worst_timestamp", "op": "eq", "value": "2025-01-02 09:00:00"},
        {"file": "bad_rows_summary.json", "path": "metrics.ultra_short.pred_M1.mean_error", "op": "between", "value": [0.4, 0.5]},
        {"file": "bad_rows_summary.json", "path": "metrics.short.pred_M1.n_rows", "op": "eq", "value": 8},
        {"file": "bad_rows_summary.json", "path": "metrics.short.pred_M1.n_bad", "op": "eq", "value": 1},
        {"file": "bad_rows_summary.json", "path": "metrics.short.pred_M1.worst_timestamp", "op": "eq", "value": "2025-01-01 09:00:00"},
        {"file": "bad_rows_summary.json", "path": "metrics.short.pred_ensemble.n_bad", "op": "eq", "value": 1},
        {"file": "bad_rows_summary.json", "path": "metrics.ultra_short.pred_M3.n_bad", "op": "eq", "value": 4},
        {"file": "bad_rows_summary.json", "path": "metrics.ultra_short.pred_M3.worst_timestamp", "op": "eq", "value": "2025-01-01 08:00:00"},
        {"file": "bad_rows_summary.json", "path": "metrics.short.pred_M3.n_bad", "op": "eq", "value": 0},
        {"file": "bad_rows_ultra_short_pred_M1.csv", "op": "exists"},
        {"file": "bad_rows_ultra_short_pred_M3.csv", "op": "exists"}
      ]
    },
    "2": {
      "desc": "特征归因：f_blame 必须四路被点名且全局 ρ 榜首；f_decoy 误差虽大（>0.9）必须零点名；f_good 零误差；f_jumpy 对 M1 零点名（零耦合），对 M3 是 ρ 榜首但 ρ=0.28<0.3 抓不牢——真值误差路径的盲区，revision 轴补位；f_jumpy_decoy 误差最大（25）必须全程零点名",
      "inputs": ["golden_feature_true.parquet", "feature_pairs.json", "bad_rows_summary.json",
                 "bad_rows_ultra_short_pred_M1.csv", "bad_rows_ultra_short_pred_ensemble.csv",
                 "bad_rows_ultra_short_pred_M3.csv", "bad_rows_short_pred_M3.csv",
                 "bad_rows_short_pred_M1.csv", "bad_rows_short_pred_ensemble.csv"],
      "args": ["--feature-true", "golden_feature_true.parquet"],
      "expect": [
        {"file": "blame_summary.json", "path": "ultra_short.pred_M1.features", "op": "argmax", "field": "global_spearman", "value": "f_blame"},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M1.ranking_by_spearman", "op": "first_is", "value": "f_blame"},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M1.features.f_blame.blamed_rows", "op": "ge", "value": 1},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M1.features.f_blame.global_spearman", "op": "ge", "value": 0.9},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M1.features.f_decoy.blamed_rows", "op": "eq", "value": 0},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M1.features.f_decoy.global_spearman", "op": "between", "value": [-0.3, 0.3]},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M1.features.f_decoy.feature_err_mean", "op": "ge", "value": 0.9},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M1.features.f_good.feature_err_mean", "op": "le", "value": 1e-06},
        {"file": "blame_summary.json", "path": "short.pred_M1.features.f_blame.blamed_rows", "op": "ge", "value": 1},
        {"file": "blame_summary.json", "path": "short.pred_M1.features.f_decoy.blamed_rows", "op": "eq", "value": 0},
        {"file": "blame_summary.json", "path": "short.pred_ensemble.features.f_blame.global_spearman", "op": "ge", "value": 0.9},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M1.features.f_jumpy.blamed_rows", "op": "eq", "value": 0},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M1.features.f_jumpy.feature_err_mean", "op": "ge", "value": 10},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M3.features", "op": "argmax", "field": "global_spearman", "value": "f_jumpy"},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M3.features.f_jumpy.global_spearman", "op": "between", "value": [0.15, 0.45]},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M1.features.f_jumpy_decoy.blamed_rows", "op": "eq", "value": 0},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M3.features.f_jumpy_decoy.blamed_rows", "op": "eq", "value": 0},
        {"file": "blame_summary.json", "path": "ultra_short.pred_M3.features.f_jumpy_decoy.feature_err_mean", "op": "ge", "value": 20},
        {"file": "blame_report.csv", "op": "exists"}
      ]
    },
    "revision": {
      "desc": "翻新跳变分析：f_jumpy 对 M3(ultra_short) 两关点名（churn ρ≈1）；f_jumpy_decoy 跳变更大但相关≈0 必须不点名（跳变大≠有罪）；M1/ensemble 行间稳定；short 切片跨夜恒幅 → churn 可观但无特征过两关；纯时间函数特征零跳变",
      "inputs": ["golden_test.parquet", "golden_predict.parquet", "golden_feature_true.parquet",
                 "feature_pairs.json"],
      "args": ["--test", "golden_test.parquet", "--predict", "golden_predict.parquet",
               "--feature-true", "golden_feature_true.parquet"],
      "expect": [
        {"file": "revision_summary.json", "path": "n_adjacent_pairs", "op": "eq", "value": 32},
        {"file": "revision_summary.json", "path": "metrics.ultra_short.pred_M3.named", "op": "contains", "value": "f_jumpy"},
        {"file": "revision_summary.json", "path": "metrics.ultra_short.pred_M3.features.f_jumpy.churn_spearman", "op": "ge", "value": 0.9},
        {"file": "revision_summary.json", "path": "metrics.ultra_short.pred_M3.features.f_jumpy_decoy.named", "op": "eq", "value": false},
        {"file": "revision_summary.json", "path": "metrics.ultra_short.pred_M3.features.f_jumpy_decoy.churn_spearman", "op": "between", "value": [-0.3, 0.3]},
        {"file": "revision_summary.json", "path": "metrics.ultra_short.pred_M3.features.f_jumpy_decoy.jump_mean", "op": "ge", "value": 20},
        {"file": "revision_summary.json", "path": "metrics.ultra_short.pred_M1.stable", "op": "eq", "value": true},
        {"file": "revision_summary.json", "path": "metrics.ultra_short.pred_ensemble.stable", "op": "eq", "value": true},
        {"file": "revision_summary.json", "path": "metrics.short.pred_M3.named", "op": "eq", "value": []},
        {"file": "revision_summary.json", "path": "features.f_blame.jumpiness_full192", "op": "le", "value": 1e-06},
        {"file": "revision_summary.json", "path": "features.f_jumpy.jumpiness_full192", "op": "ge", "value": 1.0},
        {"file": "revision_report.csv", "op": "exists"}
      ]
    },
    "4": {
      "desc": "反事实决策逻辑（cf_logic --selfcheck，零网络）：合成模型断言 G 闸拦「非特征问题」、冗余对单换无效但消解找到 {f1,f2}、Shapley 对冗余对均分且诱饵零分、协同对单换即修、invalid 保守保留。HTTP 层（counterfactual_api.py）无法过闸（gen_gate 禁 urllib）——其正确性靠本 stage 钉决策逻辑 + --dry-run 人工确认 payload",
      "inputs": [],
      "args": ["--selfcheck"],
      "expect": [
        {"file": "cf_logic_selfcheck.json", "path": "passed", "op": "eq", "value": true},
        {"file": "cf_logic_selfcheck.json", "path": "checks.redundant_solo_useless", "op": "eq", "value": true},
        {"file": "cf_logic_selfcheck.json", "path": "checks.redundant_pair_found", "op": "eq", "value": true},
        {"file": "cf_logic_selfcheck.json", "path": "checks.shapley_equal_split", "op": "eq", "value": true},
        {"file": "cf_logic_selfcheck.json", "path": "checks.gap_gate_blocks", "op": "eq", "value": true},
        {"file": "cf_logic_selfcheck.json", "path": "checks.invalid_keeps_feature", "op": "eq", "value": true}
      ]
    }
  }
}
