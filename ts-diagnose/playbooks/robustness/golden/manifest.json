{
  "playbook": "robustness",
  "note": "金标准输入由 make_golden.py 确定性生成（零随机）：整体差异全部由 2 个极端单位驱动的『假差异』。期望值来自 reference/perturbation.py 实跑并留容差。Stage 0 基线复算要对用户原始数字对账，无法预置金标准——用菜谱验证步。含随机性的扰动族（bootstrap）不进 expect。改期望前先改 make_golden.py 并重跑 pytest。",
  "planted": {
    "fake_difference_drivers": [
      "d03",
      "d07"
    ],
    "true_direction": "B 略优（18/20 单位）"
  },
  "stages": {
    "1": {
      "desc": "扰动矩阵必须抓出假差异：剔最差 k 与子期均翻向，稳定分 0",
      "inputs": [
        "paired_metrics.csv"
      ],
      "args": [
        "--pairs",
        "paired_metrics.csv",
        "--out",
        "perturbation_matrix.json"
      ],
      "expect": [
        {
          "file": "perturbation_matrix.json",
          "path": "conclusions.C1.baseline_diff",
          "op": "between",
          "value": [
            0.05,
            0.25
          ]
        },
        {
          "file": "perturbation_matrix.json",
          "path": "conclusions.C1.n_units",
          "op": "eq",
          "value": 20
        },
        {
          "file": "perturbation_matrix.json",
          "path": "conclusions.C1.families.drop_worst_k.direction_preserved",
          "op": "eq",
          "value": false
        },
        {
          "file": "perturbation_matrix.json",
          "path": "conclusions.C1.families.drop_worst_k.effect_after",
          "op": "le",
          "value": -0.01
        },
        {
          "file": "perturbation_matrix.json",
          "path": "conclusions.C1.families.subperiod.direction_preserved",
          "op": "eq",
          "value": false
        },
        {
          "file": "perturbation_matrix.json",
          "path": "conclusions.C1.families.wilcoxon.median_diff",
          "op": "le",
          "value": -0.01
        },
        {
          "file": "perturbation_matrix.json",
          "path": "conclusions.C1.stability_score",
          "op": "eq",
          "value": 0
        }
      ],
      "reference": "reference/perturbation.py"
    }
  }
}