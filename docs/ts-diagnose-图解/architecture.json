  "cards": [
    {
      "dot": "cyan",
      "title": "三层怎么分工",
      "items": [
        "入口只做一件事：认目标、选剧本，不讲做法",
        "运行时是代码：导航员、关卡、钩子，替模型记住走到哪、拦住跳步",
        "方法库是文字：剧本讲每阶段做什么，图库给现成脚本，手册讲纪律"
      ]
    },
    {
      "dot": "emerald",
      "title": "谁负责什么",
      "items": [
        "主 agent（Claude 本体）负责问用户、整理现象、写结论",
        "子代理按卡片干重活：整理数据、算指标、画图、重训做消融",
        "所有结果落在工作目录：进度、现象清单、结论、收据"
      ]
    },
    {
      "dot": "amber",
      "title": "装到另一台电脑",
      "items": [
        "clone 仓库后运行 bash ts-diagnose/install.sh",
        "脚本把 skill、13 张卡片、3 个钩子链接进 ~/.claude，再用 --check 验证"
      ]
    }
  ]
