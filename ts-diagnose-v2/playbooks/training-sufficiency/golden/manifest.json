{
  "playbook": "training-sufficiency",
  "note": "金标准输入由 make_golden.py 确定性生成（零随机）；期望值来自 reference/ 参考实现的实跑并留容差。Stage 0/1 依赖真实记录源格式，无法预置金标准——用菜谱声明的对账验证步。改本文件的期望前先改 make_golden.py 并重跑 pytest。",
  "planted": {
    "loss_side_hard_member": "m3",
    "target_side_harm_member": "m2"
  },
  "stages": {
    "2": {
      "desc": "动力学指标：24 条曲线全部到平台，边际增益已知",
      "inputs": [
        "loss_records.csv"
      ],
      "args": [
        "--loss-csv",
        "loss_records.csv",
        "--out",
        "dynamics_metrics.json"
      ],
      "expect": [
        {
          "file": "dynamics_metrics.json",
          "path": "summary.S1.n_curves",
          "op": "eq",
          "value": 24
        },
        {
          "file": "dynamics_metrics.json",
          "path": "summary.S1.n_plateaued",
          "op": "eq",
          "value": 24
        },
        {
          "file": "dynamics_metrics.json",
          "path": "summary.S1.worst_marginal_gain",
          "op": "between",
          "value": [
            0.001,
            0.05
          ]
        },
        {
          "file": "dynamics_metrics.json",
          "path": "curves.0.conv_slope",
          "op": "le",
          "value": -0.001
        }
      ],
      "reference": "reference/dynamics.py"
    },
    "3": {
      "desc": "成分回归：植入难学成员 m3 必须 θ_loss top-1",
      "inputs": [
        "dynamics_metrics.json",
        "assignments.csv"
      ],
      "args": [
        "--dynamics",
        "dynamics_metrics.json",
        "--assignments",
        "assignments.csv",
        "--out",
        "composition_effects.json"
      ],
      "expect": [
        {
          "file": "composition_effects.json",
          "path": "series.S1.theta",
          "op": "argmax",
          "value": "m3"
        },
        {
          "file": "composition_effects.json",
          "path": "series.S1.ranking",
          "op": "first_is",
          "value": "m3"
        },
        {
          "file": "composition_effects.json",
          "path": "series.S1.theta.m3",
          "op": "between",
          "value": [
            0.1,
            0.45
          ]
        },
        {
          "file": "composition_effects.json",
          "path": "series.S1.power_note",
          "op": "exists"
        }
      ],
      "reference": "reference/composition.py"
    },
    "4": {
      "desc": "外部指标关联：对齐无缺口，植入拖累成员 m2 必须 θ_target top-1",
      "inputs": [
        "dynamics_metrics.json",
        "external_metric.csv",
        "assignments.csv"
      ],
      "args": [
        "--dynamics",
        "dynamics_metrics.json",
        "--external",
        "external_metric.csv",
        "--assignments",
        "assignments.csv",
        "--out",
        "external_link.json"
      ],
      "expect": [
        {
          "file": "external_link.json",
          "path": "aligned_keys",
          "op": "eq",
          "value": 24
        },
        {
          "file": "external_link.json",
          "path": "target_theta",
          "op": "argmax",
          "value": "m2"
        },
        {
          "file": "external_link.json",
          "path": "target_ranking",
          "op": "first_is",
          "value": "m2"
        },
        {
          "file": "external_link.json",
          "path": "spearman_loss_vs_target",
          "op": "between",
          "value": [
            0.25,
            0.75
          ]
        }
      ],
      "reference": "reference/external_link.py"
    }
  }
}