{
  "playbook": "metric-eval",
  "note": "口径金标准：模型 A 恒定偏置 +0.5（每行误差平方 0.25）手算 rmse_192=0.5；模型 B 交替偏置 ±1.0（每行误差平方 1.0）手算 rmse_192=1.0——两值零随机、可手复核，无需再跑代码验证。Stage 1 的 product_manifest.py 是引擎机制脚本，不进 gen_gate——gen_gate 只闸运行时生成脚本。改期望先改 make_golden.py 并重新手算。",
  "planted": {"rmse_A": 0.5, "rmse_B": 1.0, "n_rows": 16},
  "stages": {
    "0": {
      "desc": "按 rmse_192 口径逐模型算指标 + 自足汇总",
      "inputs": ["predictions.csv"],
      "args": ["--pred", "predictions.csv", "--caliber", "rmse_192",
               "--out", "metrics.csv", "--summary", "metrics_summary.json"],
      "expect": [
        {"file": "metrics_summary.json", "path": "models.A", "op": "eq", "value": 0.5},
        {"file": "metrics_summary.json", "path": "models.B", "op": "eq", "value": 1.0},
        {"file": "metrics_summary.json", "path": "n_rows", "op": "eq", "value": 16},
        {"file": "metrics_summary.json", "path": "caliber", "op": "contains", "value": "RMSE"}
      ],
      "reference": "reference/stage0_metrics.py"
    }
  }
}
