{
  "playbook": "deployment-drift",
  "note": "金标准由 make_golden.py 确定性生成（零随机，奇偶/模三交替提供确定性噪声）。植入难例形态（spec §5 硬规则）：渐变 ramp——真实 onset=40、最大分离切分点落 ramp 中段（46）——expect 强制 shape+onset 双答对，只报切分点过不了闸；诱饵 decoy_feat 全期无偏移防冤枉。置换基线 seed=0/n_perm=200（种子豁免边界：显式 CLI 参数并落 JSON），改种子=改期望。Stage 0 依赖真实数据格式不建金标准（对账两关兜底）；Stage 2 图脚本由 chartbook 自带 golden 闸住。改期望先改 make_golden.py 并重跑 pytest。",
  "planted": {
    "true_onset": 40,
    "ramp_end": 48,
    "shape": "gradual",
    "cause_feature": "drift_feat",
    "decoy_feature": "decoy_feat",
    "rmse_pre": 1.0,
    "rmse_post": 3.0
  },
  "stages": {
    "1": {
      "desc": "退化判定与时点：切分点落 ramp 中段（46）但 onset 首离判据须回收 40-42、形态判 gradual、过置换基线与奇偶交错重切",
      "inputs": ["error_series.csv"],
      "args": ["--series", "error_series.csv", "--out", "changepoint_summary.json", "--seed", "0", "--n-perm", "200"],
      "reference": "reference/changepoint.py",
      "expect": [
        {"file": "changepoint_summary.json", "path": "shape", "op": "eq", "value": "gradual"},
        {"file": "changepoint_summary.json", "path": "onset_index", "op": "between", "value": [40, 42]},
        {"file": "changepoint_summary.json", "path": "split_index", "op": "between", "value": [42, 50]},
        {"file": "changepoint_summary.json", "path": "gap_z", "op": "ge", "value": 5},
        {"file": "changepoint_summary.json", "path": "pre.mean", "op": "between", "value": [1.0, 1.25]},
        {"file": "changepoint_summary.json", "path": "post.mean", "op": "between", "value": [2.8, 3.1]},
        {"file": "changepoint_summary.json", "path": "interleave.consistent", "op": "eq", "value": true},
        {"file": "changepoint_summary.json", "path": "stability.direction_preserved", "op": "eq", "value": true},
        {"file": "changepoint_summary.json", "path": "perm.verdict", "op": "eq", "value": "significant"},
        {"file": "changepoint_summary.json", "path": "perm.p", "op": "le", "value": 0.05},
        {"file": "changepoint_summary.json", "path": "perm.null_q95", "op": "le", "value": 10}
      ]
    },
    "3": {
      "desc": "诱因筛查：drift_feat 双关命中（偏移+秩相关）且 onset=40 与误差侧重合；decoy_feat 不许被点名",
      "inputs": ["features.csv", "error_series.csv"],
      "args": ["--features", "features.csv", "--series", "error_series.csv", "--split", "46", "--out", "cause_screen.json"],
      "reference": "reference/cause_screen.py",
      "expect": [
        {"file": "cause_screen.json", "path": "ranking", "op": "first_is", "value": "drift_feat"},
        {"file": "cause_screen.json", "path": "features.drift_feat.shifted", "op": "eq", "value": true},
        {"file": "cause_screen.json", "path": "features.drift_feat.shift_p", "op": "le", "value": 0.01},
        {"file": "cause_screen.json", "path": "features.drift_feat.spearman_vs_error", "op": "ge", "value": 0.5},
        {"file": "cause_screen.json", "path": "features.drift_feat.onset_index", "op": "between", "value": [39, 42]},
        {"file": "cause_screen.json", "path": "features.decoy_feat.shifted", "op": "eq", "value": false},
        {"file": "cause_screen.json", "path": "features.decoy_feat.shift_p", "op": "ge", "value": 0.05}
      ]
    }
  }
}
